{
  "name": "benda",
  "version": "0.1.0",
  "private": true,
  "description": "Point at an element in a running web app, an AI agent changes exactly that element in the source.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "pack": "mkdir -p dist && npm pack --workspaces --pack-destination dist",
    "test": "node --test packages/*/test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
