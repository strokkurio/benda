{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "benda",
      "include-component-in-tag": false,
      "extra-files": [
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/angular/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/angular/package.json", "jsonpath": "$.peerDependencies['@strokkur/benda']" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/core'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/angular'].version" },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/angular'].peerDependencies['@strokkur/benda']"
        }
      ]
    }
  }
}
